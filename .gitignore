# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/videos

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/home-planet-2800x2100.png
/applications/
/.codex/

# local GIF capture/build artifacts
/tmp/
/output/
/tmp/*.py
/tmp/*.js
/tmp/*.mjs
/tmp/*.gif
/tmp/*.log
/tmp/**/*.png
/tmp/**/*.jpg
/tmp/**/*.jpeg
/tmp/**/*.webp
/tmp/**/*.mp4
/tmp/**/*.webm
/tmp/**/*.mov
/tmp/**/*.avi

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
